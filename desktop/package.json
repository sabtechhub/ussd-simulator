{
  "name": "ussd-simulator",
  "productName": "SAB-TECH HUB USSD Simulator",
  "version": "1.0.0",
  "description": "Build and test USSD (short code) menus for Hubtel and Nalo, with no code.",
  "author": "SAB-TECH HUB",
  "homepage": "https://sabtechhub.com/ussd-simulator/",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.js",
    "start": "node copy-web.js && electron .",
    "dist:win": "node copy-web.js && electron-builder --win --publish never",
    "dist:mac": "node copy-web.js && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.sabtechhub.ussdsimulator",
    "artifactName": "USSD-Simulator-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "server.js",
      "mock.js",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "web",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "USSD Simulator",
      "artifactName": "USSD-Simulator-Setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "USSD-Simulator-mac.${ext}"
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@highlightjs/cdn-assets": "^11.9.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  }
}
